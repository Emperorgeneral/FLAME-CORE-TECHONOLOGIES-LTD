# ============================================================
# Flame Core — Marketing Website Only (Maintenance Mode)
# ============================================================
#
# Serves only the marketing page at:
# - flamecoretechltd.com & www.flamecoretechltd.com
#
# Backend and hosting platform are offline for maintenance.

# ========================================================
# Rate limiting
# ========================================================
limit_req_zone $binary_remote_addr zone=general:10m rate=100r/s;

# ========================================================
# Redirect HTTP to HTTPS
# ========================================================

server {
    listen 80;
    listen [::]:80;
    server_name flamecoretechltd.com www.flamecoretechltd.com;
    location /.well-known/acme-challenge {
        root /var/www/certbot;
    }
    
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# ========================================================
# HTTPS: Main Marketing Website
# ========================================================

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name flamecoretechltd.com www.flamecoretechltd.com;

    # SSL certificates (provision with: certbot certonly --standalone -d flamecoretechltd.com -d www.flamecoretechltd.com)
    ssl_certificate /etc/letsencrypt/live/flamecoretechltd.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/flamecoretechltd.com/privkey.pem;

    # SSL configuration (best practices)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;

    # Logging
    access_log /var/log/nginx/flamecore-website-access.log combined;
    error_log /var/log/nginx/flamecore-website-error.log warn;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 256;
    gzip_comp_level 6;

    # Rate limiting
    limit_req zone=general burst=20 nodelay;

    # Canonical redirect (www → non-www)
    if ($server_name = "www.flamecoretechltd.com") {
        return 301 https://flamecoretechltd.com$request_uri;
    }

    # Static files (from Vite build: dist/)
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot)$ {
        root /var/www/marketing;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback (index.html for React Router)
    location / {
        root /var/www/marketing;
        try_files $uri /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }
}
